+    <button class="padBtn right vbRightRight" data-input="15" aria-label="Croix droite droite"><i class="tri"></i></button>
+    <button class="padBtn down vbRightDown" data-input="14" aria-label="Croix droite bas"><i class="tri"></i></button>`;
+  app.appendChild(pad);
+  [...pad.querySelectorAll('.padBtn')].forEach(bindInputButton);
+
+  const baseUpdateController=updateController;
+  updateController=function(systemId){
+    const out=baseUpdateController(systemId);
+    pad.style.display=systemId==='vb'?'block':'none';
+    return out;
   };
+  pad.style.display='none';
+  globalThis.__RETROOM_VB_PAD_TEST__={pad,inputs:{up:12,left:13,down:14,right:15}};
 })();
 </script>
 
