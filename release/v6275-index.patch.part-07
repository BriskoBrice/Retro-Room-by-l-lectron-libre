+      'nintendo-game-boy':'gb','nintendo-game-boy-color':'gb','nintendo-64':'n64',
+      'neo-geo-pocket':'ngp','neo-geo-pocket-color':'ngp','wonderswan':'ws','wonderswan-color':'ws',
+      'commodore-amiga':'amiga','commodore-64':'c64','zx-spectrum':'spectrum','amstrad-cpc':'amstrad'
