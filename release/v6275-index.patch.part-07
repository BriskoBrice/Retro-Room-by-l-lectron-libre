+  const RETROBIOS_PLATFORM_API='https://abdess.github.io/retrobios/api/v1/platforms.json';
+  let retroBiosCatalogPromise=null;
+  function mapRetroBiosSystem(sourceId=''){
+    const raw=String(sourceId||'').toLowerCase();
+    const direct={
+      '3do':'threeDO','playstation':'psx','sony-playstation':'psx',
+      'playstation-portable':'psp','sony-playstation-portable':'psp',
+      'sega-saturn':'segaSaturn','saturn':'segaSaturn','sega-dreamcast':'dreamcast','dreamcast':'dreamcast',
+      'sega-cd':'segaCD','mega-cd':'segaCD','sega-mega-cd':'segaCD',
+      'pc-engine-cd':'pce','nec-pc-engine-cd':'pce','pc-fx':'pcfx','nec-pc-fx':'pcfx',
