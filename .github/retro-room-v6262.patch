+  const OPERA_RE=/^(?:panafz1(?:0)?(?:e-anvil)?(?:-patched|-norsa|-kanji)?|panafz10ja-anvil-kanji|3do_arcade_saot|goldstar|sanyotry)\.bin$/i;
+  function isBiosArchiveExt(ext=''){return ARCHIVE_EXTS.has(String(ext||'').toLowerCase());}
+  function psxCanonicalName(name=''){
+    const base=basename(name),ext=extOfName(base),stem=stemOfName(base).toLowerCase();
+    if(!PSX_RAW_EXTS.has(ext))return null;
+    if(/^scph[0-9a-z_-]+$/i.test(stem))return stem+'.bin';
+    if(stem==='psxonpsp660')return 'PSXONPSP660.bin';
+    if(stem==='ps1_rom')return 'ps1_rom.bin';
+    if(stem==='openbios')return 'openbios.bin';
+    return null;
+  }
+  function isPsxBiosName(name=''){return !!psxCanonicalName(name);}
+  function normalizePsxBiosFile(file,nameOverride=''){
+    if(!file)return null;
+    const sourceName=nameOverride||file.name||'';
+    const canonical=psxCanonicalName(sourceName);
