+<script id="psx-support-v626-script">
+(() => {
+  'use strict';
+  if(globalThis.__RETROOM_PSX_V626__)return;
+
+  const pathOf=f=>String(f?.webkitRelativePath||f?.name||'').replace(/\\/g,'/');
+  const extOfName=n=>(String(n||'').split('.').pop()||'').toLowerCase();
+  const basename=p=>String(p||'').replace(/\\/g,'/').split('/').filter(Boolean).pop()||'';
+  const stemOfName=n=>basename(n).replace(/\.[^.]+$/,'');
+  const normalizePath=p=>{
+    const parts=[];
+    for(const raw of String(p||'').replace(/\\/g,'/').split('/')){
+      const part=raw.trim();if(!part||part==='.')continue;if(part==='..'){if(parts.length)parts.pop();continue;}parts.push(part);
+    }
+    return parts.join('/').toLowerCase();
+  };
+  const parentPath=p=>{const n=normalizePath(p);const i=n.lastIndexOf('/');return i>=0?n.slice(0,i):'';};
+  const resolveSibling=(base,ref)=>normalizePath((base?base+'/':'')+String(ref||''));
+  function cueFileReferences(text=''){
+    const out=[];for(const raw of String(text||'').split(/\r?\n/)){
+      const line=raw.trim();let m=line.match(/^FILE\s+"([^"]+)"\s+/i);if(!m)m=line.match(/^FILE\s+([^\s]+)\s+/i);if(m)out.push(m[1].replace(/\\/g,'/'));
+    }return [...new Set(out)];
+  }
+  function isPsxSystem(file,resolveSystem){try{return resolveSystem(file)==='psx';}catch(_){return false;}}
+  async function canonicalizePsxDiscFiles(files,{candidate,resolveSystem,extOf}){
+    const all=[...(files||[])],candidates=all.filter(candidate),byPath=new Map();
+    for(const f of all){const p=normalizePath(pathOf(f));if(p)byPath.set(p,f);}
+    const cueFiles=candidates.filter(f=>extOf(f)==='cue'&&isPsxSystem(f,resolveSystem));
+    const referenced=new Set(),missing=new Set(),auxiliary=new Set();
+    await Promise.all(cueFiles.map(async cue=>{
+      let text='';try{text=await cue.text();}catch(_){return;}
+      const base=parentPath(pathOf(cue));
+      for(const ref of cueFileReferences(text)){
+        const key=resolveSibling(base,ref),file=byPath.get(key);
+        if(file)referenced.add(file);else missing.add(key);
+      }
+      // Les sidecars ne sont jamais des jeux autonomes quand un CUE de même base existe.
+      const cueStem=normalizePath(resolveSibling(base,stemOfName(cue.name)));
+      for(const f of all){
+        const ext=extOf(f);if(!['sbi','sub'].includes(ext))continue;
+        const fp=normalizePath(pathOf(f));const stem=normalizePath(resolveSibling(parentPath(pathOf(f)),stemOfName(f.name)));
+        if(stem===cueStem)auxiliary.add(f);
+      }
+    }));
+    return candidates.filter(f=>{
+      if(!isPsxSystem(f,resolveSystem))return true;
+      if(referenced.has(f)||auxiliary.has(f))return false;
+      const ext=extOf(f);if(['sbi','sub','toc'].includes(ext))return false;
+      return true;
+    });
+  }
+  async function resolvePsxCueBundle(allFiles,cueFile){
+    const byPath=new Map();for(const f of (allFiles||[])){const p=normalizePath(pathOf(f));if(p)byPath.set(p,f);}
+    const base=parentPath(pathOf(cueFile));let text='';try{text=await cueFile.text();}catch(_){text='';}
+    const refs=cueFileReferences(text),found=[],missing=[],externalFiles={};
+    for(const ref of refs){
+      const f=byPath.get(resolveSibling(base,ref));
+      if(f){found.push(f);externalFiles['/'+ref.replace(/^\/+/, '')]=f;externalFiles['/'+basename(ref)]=f;}else missing.push(ref);
+    }
+    // Sidecars utiles à certains dumps protégés.
+    const cueStem=stemOfName(cueFile.name).toLowerCase();
+    for(const f of (allFiles||[])){
+      const ext=extOfName(f.name);if(!['sbi','sub'].includes(ext))continue;
+      if(parentPath(pathOf(f))!==base)continue;
+      const stem=stemOfName(f.name).toLowerCase();if(stem!==cueStem)continue;
+      externalFiles['/'+f.name]=f;
+    }
+    return {refs,files:found,missing,externalFiles};
+  }
+
+  const PSX_RAW_EXTS=new Set(['bin','rom','bios','img','dat']);
+  const ARCHIVE_EXTS=new Set(['zip','7z','rar']);
+  const PSX_PRIORITY=[
