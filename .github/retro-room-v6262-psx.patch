+<script id="psx-support-v626-script">
+(() => {
+  'use strict';
+  if(globalThis.__RETROOM_PSX_V626_READY__)return;
+  globalThis.__RETROOM_PSX_V626_READY__=true;
+
+  const pathOf=file=>String(file?.webkitRelativePath||file?.name||'').replace(/\\/g,'/');
+  const extOfName=name=>(String(name||'').split('.').pop()||'').toLowerCase();
+  const stemOfName=name=>String(name||'').replace(/\.[^./]+$/,'');
+  const basename=path=>String(path||'').replace(/\\/g,'/').split('/').pop()||'';
+  function normalizePath(path=''){
+    const parts=[];
+    for(const raw of String(path||'').replace(/\\/g,'/').split('/')){
+      const part=raw.trim();
+      if(!part||part==='.')continue;
+      if(part==='..'){if(parts.length)parts.pop();continue;}
+      parts.push(part);
+    }
+    return parts.join('/').toLowerCase();
+  }
+  const parentPath=path=>{const n=normalizePath(path);const i=n.lastIndexOf('/');return i>=0?n.slice(0,i):'';};
+  const resolveSibling=(base,ref)=>normalizePath((base?base+'/':'')+String(ref||''));
+  const stripExt=path=>String(path||'').replace(/\.[^./]+$/,'');
+
+  function cueFileReferences(text=''){
+    const refs=[];
+    const re=/^\s*FILE\s+(?:"([^"]+)"|'([^']+)'|(.+?))\s+(?:BINARY|MOTOROLA|WAVE|MP3|AIFF)\s*$/gim;
+    let m;
+    while((m=re.exec(String(text||'')))){
+      const ref=(m[1]||m[2]||m[3]||'').trim();
+      if(ref)refs.push(ref);
+    }
+    return refs;
+  }
+
+  async function canonicalizePsxDiscFiles(files,{candidate,resolveSystem,extOf}){
+    const list=[...files].filter(candidate);
+    const auxBins=new Set(),cueStemFallbacks=new Set(),sidecars=new Set();
+    const systemCache=new WeakMap();
+    const systemOf=file=>{
+      if(file&&typeof file==='object'&&systemCache.has(file))return systemCache.get(file);
+      let value=null;try{value=resolveSystem(file);}catch(_){ }
+      if(file&&typeof file==='object')systemCache.set(file,value);
+      return value;
+    };
+    const cues=list.filter(f=>extOf(f)==='cue'&&systemOf(f)==='psx');
+    await Promise.all(cues.map(async cue=>{
+      const cuePath=normalizePath(pathOf(cue));
+      const cueStem=stripExt(cuePath);cueStemFallbacks.add(cueStem);
+      const base=parentPath(cuePath);
+      try{
+        const text=typeof cue.text==='function'?await cue.text():'';
+        for(const ref of cueFileReferences(text)){
+          const resolved=resolveSibling(base,ref);
+          if(extOfName(ref)==='bin')auxBins.add(resolved);
+        }
+      }catch(_){ }
+      sidecars.add(cueStem+'.sbi');
+      sidecars.add(cueStem+'.sub');
+    }));
+    return list.filter(file=>{
+      if(systemOf(file)!=='psx')return true;
+      const ext=extOf(file),p=normalizePath(pathOf(file)),stem=stripExt(p);
+      if(ext==='bin'&&(auxBins.has(p)||cueStemFallbacks.has(stem)))return false;
+      if((ext==='sbi'||ext==='sub')&&sidecars.has(p))return false;
+      return true;
+    });
+  }
+
+  async function resolvePsxCueBundle(files,cue){
+    const cuePath=normalizePath(pathOf(cue));
+    const base=parentPath(cuePath);
+    const text=typeof cue.text==='function'?await cue.text():'';
+    const refs=cueFileReferences(text);
+    const byPath=new Map((files||[]).map(f=>[normalizePath(pathOf(f)),f]));
+    const found=[],missing=[],externalFiles={};
+    for(const ref of refs){
+      const resolved=resolveSibling(base,ref),file=byPath.get(resolved);
+      if(file){
+        found.push(file);
+        externalFiles['/'+String(ref).replace(/\\/g,'/').replace(/^\/+/, '')]=file;
+      }else missing.push(ref);
+    }
+    const cueStem=stripExt(cuePath);
+    for(const ext of ['sbi','sub']){
+      const side=byPath.get(cueStem+'.'+ext);
+      if(side)externalFiles['/'+basename(pathOf(side))]=side;
+    }
+    return {refs,files:found,missing,externalFiles};
+  }
+
+  const PSX_RAW_EXTS=new Set(['bin','rom','bios','img','dat']);
+  const ARCHIVE_EXTS=new Set(['zip','7z','rar']);
+  const PSX_PRIORITY=[
+    'psxonpsp660.bin','scph101.bin','scph7001.bin','scph5501.bin','scph1001.bin',
+    'scph5502.bin','scph5500.bin','ps1_rom.bin','openbios.bin'
+  ];
+  const OPERA_RE=/^(?:panafz1(?:0)?(?:e-anvil)?(?:-patched|-norsa|-kanji)?|panafz10ja-anvil-kanji|3do_arcade_saot|goldstar|sanyotry)\.bin$/i;
+  function isBiosArchiveExt(ext=''){return ARCHIVE_EXTS.has(String(ext||'').toLowerCase());}
+  function psxCanonicalName(name=''){
+    const base=basename(name),ext=extOfName(base),stem=stemOfName(base).toLowerCase();
+    if(!PSX_RAW_EXTS.has(ext))return null;
+    if(/^scph[0-9a-z_-]+$/i.test(stem))return stem+'.bin';
+    if(stem==='psxonpsp660')return 'PSXONPSP660.bin';
+    if(stem==='ps1_rom')return 'ps1_rom.bin';
+    if(stem==='openbios')return 'openbios.bin';
+    return null;
+  }
+  function isPsxBiosName(name=''){return !!psxCanonicalName(name);}
+  function normalizePsxBiosFile(file,nameOverride=''){
+    if(!file)return null;
+    const sourceName=nameOverride||file.name||'';
+    const canonical=psxCanonicalName(sourceName);
+    if(!canonical)return null;
+    if(String(file.name||'').toLowerCase()===canonical.toLowerCase())return file;
+    try{return new File([file],canonical,{type:file.type||'application/octet-stream',lastModified:file.lastModified||Date.now()});}
+    catch(_){try{file.name=canonical;}catch(__){}return file;}
+  }
+  function flattenExtracted(entries,out=[]){
+    for(const e of (entries||[])){
+      if(!e)continue;
+      if(e.file)out.push(e);
+      if(Array.isArray(e.children))flattenExtracted(e.children,out);
+    }
+    return out;
+  }
+  function pickPsxBiosFromExtracted(entries){
+    const candidates=[];
+    for(const entry of flattenExtracted(entries)){
+      const name=entry.pathname||entry.filename||entry.file?.name||'';
+      const normalized=normalizePsxBiosFile(entry.file,basename(name));
+      if(normalized)candidates.push(normalized);
+    }
+    return choosePsxBios(candidates);
+  }
+  function choosePsxBios(files){
+    const byName=new Map();
+    for(const f of (files||[])){
+      const normalized=normalizePsxBiosFile(f);
+      if(normalized)byName.set(String(normalized.name||'').toLowerCase(),normalized);
+    }
+    for(const name of PSX_PRIORITY)if(byName.has(name.toLowerCase()))return byName.get(name.toLowerCase());
+    const generic=[...byName.entries()].filter(([n])=>/^scph/.test(n)).sort(([a],[b])=>a.localeCompare(b));
+    return generic[0]?.[1]||[...byName.values()][0]||null;
+  }
+  function collectRecognizedFromExtracted(entries){
+    const psx=[],opera=[];
+    for(const entry of flattenExtracted(entries)){
+      const path=entry.pathname||entry.filename||entry.file?.name||'';
+      const name=basename(path),file=entry.file;
+      const p=normalizePsxBiosFile(file,name);if(p)psx.push(p);
+      if(file&&OPERA_RE.test(name)){
+        if(String(file.name||'').toLowerCase()===name.toLowerCase())opera.push(file);
+        else{try{opera.push(new File([file],name,{type:file.type||'application/octet-stream',lastModified:file.lastModified||Date.now()}));}catch(_){opera.push(file);}}
+      }
+    }
+    return {psx,opera};
+  }
+
+  let archiveRuntimePromise=null;
+  function ensureArchiveRuntime(){
+    if(globalThis.filing?.FilingBrowser)return Promise.resolve(globalThis.filing.FilingBrowser);
+    if(archiveRuntimePromise)return archiveRuntimePromise;
+    archiveRuntimePromise=new Promise((resolve,reject)=>{
+      const existing=document.getElementById('retroom-filing-v626');
+      if(existing){existing.addEventListener('load',()=>resolve(globalThis.filing?.FilingBrowser),{once:true});existing.addEventListener('error',()=>reject(new Error('filing CDN error')),{once:true});return;}
+      const s=document.createElement('script');s.id='retroom-filing-v626';
+      s.src='https://unpkg.com/filing@0.1.2/dist/umd/filing.min.js';s.async=true;
+      s.onload=()=>globalThis.filing?.FilingBrowser?resolve(globalThis.filing.FilingBrowser):reject(new Error('filing unavailable'));
+      s.onerror=()=>reject(new Error('filing CDN error'));
+      document.head.appendChild(s);
+    });
+    return archiveRuntimePromise;
+  }
+  async function extractArchive(file){
+    const FilingBrowser=await ensureArchiveRuntime();
+    const filing=new FilingBrowser({wasmUrl:'https://unpkg.com/filing@0.1.2/dist/esm/wasm/archive.wasm'});
+    return await filing.extract(file);
+  }
+
+  globalThis.__RETROOM_PSX_BIOS_FILES__=globalThis.__RETROOM_PSX_BIOS_FILES__||[];
+  globalThis.__RETROOM_PSX_SCAN_FILES__=globalThis.__RETROOM_PSX_SCAN_FILES__||[];
+  function dedupeFiles(files){
+    const m=new Map();for(const f of (files||[]))if(f)m.set(String(f.name||'').toLowerCase(),f);return [...m.values()];
+  }
+  async function processBiosSelection(all){
+    const psx=[],opera=[];let archiveErrors=0,archives=0;
+    for(const file of (all||[])){
+      const name=String(file?.name||''),ext=extOfName(name);
+      const p=normalizePsxBiosFile(file);if(p)psx.push(p);
+      if(OPERA_RE.test(name))opera.push(file);
+      if(isBiosArchiveExt(ext)){
+        archives++;
+        try{
+          const entries=await extractArchive(file);
+          const got=collectRecognizedFromExtracted(entries);
+          psx.push(...got.psx);opera.push(...got.opera);
+        }catch(err){archiveErrors++;console.warn('RetroRoom BIOS archive',name,err);}
+      }
+    }
+    globalThis.__RETROOM_PSX_BIOS_FILES__=dedupeFiles(psx);
+    globalThis.__RETROOM_V616_BIOS_FILES__=dedupeFiles(opera);
+    return {psx:globalThis.__RETROOM_PSX_BIOS_FILES__,opera:globalThis.__RETROOM_V616_BIOS_FILES__,archives,archiveErrors};
+  }
+
+  const biosInput=document.getElementById('biosFolderInput');
+  const biosBtn=document.getElementById('biosFolderBtn');
+  if(biosInput){
+    document.addEventListener('change',e=>{
+      if(e.target!==biosInput||!biosInput.files?.length)return;
+      const all=[...biosInput.files];
+      if(biosBtn){biosBtn.disabled=true;biosBtn.textContent='BIOS …';}
+      Promise.resolve(processBiosSelection(all)).then(info=>{
+        const total=info.psx.length+info.opera.length;
+        if(biosBtn){biosBtn.disabled=false;biosBtn.textContent=total?`BIOS ${total} ✓`:'BIOS !';biosBtn.title=`3DO ${info.opera.length} • PS1 ${info.psx.length}`;}
+        try{
+          const archiveNote=info.archives?` • archives ${info.archives-info.archiveErrors}/${info.archives}`:'';
+          showToast(total?`BIOS : 3DO ${info.opera.length} • PS1 ${info.psx.length}${archiveNote}`:`Aucun BIOS 3DO/PS1 reconnu${archiveNote}`,4800);
+        }catch(_){ }
+        biosInput.value='';
+      }).catch(()=>{
+        if(biosBtn){biosBtn.disabled=false;biosBtn.textContent='BIOS !';}
+        try{showToast('BIOS : impossible de lire la sélection.',4800);}catch(_){ }
+        biosInput.value='';
+      });
+    },true);
+  }
+
+  document.addEventListener('retroom-fast-folder-scan',e=>{
+    globalThis.__RETROOM_PSX_SCAN_FILES__=e.detail?.allFiles||e.detail?.romFiles||[];
+  });
+
+  function psxBios(){return choosePsxBios(globalThis.__RETROOM_PSX_BIOS_FILES__||[]);}
+  if(typeof launchRom==='function'){
+    const baseLaunch=launchRom;
+    launchRom=function(file){
+      let sid=null;try{sid=chooseSystem(file);}catch(_){ }
+      if(sid!=='psx')return baseLaunch(file);
+      const ext=extOfName(file?.name);
+      const files=globalThis.__RETROOM_PSX_SCAN_FILES__||[];
+      const bios=psxBios();
+      const launchPrepared=(externalFiles={})=>{
+        window.EJS_externalFiles=externalFiles;
+        window.EJS_disableCue=false;
+        window.EJS_biosUrl=bios||'';
+        globalThis.__RETROOM_PSX_BUNDLE_READY__=true;
+        let out;
+        try{
+          out=baseLaunch(file);
+          // V6.26.1 — comme le correctif 3DO : conserver le vrai File .cue
+          // comme média principal. Le Blob URL sans extension peut démarrer
+          // le core PS1 à vide dans le menu RetroArch.
+          if(ext==='cue'){
+            window.EJS_gameUrl=file;
+            window.EJS_disableCue=false;
+          }
+        }finally{globalThis.__RETROOM_PSX_BUNDLE_READY__=false;}
+        return out;
+      };
+      if(ext!=='cue')return launchPrepared({});
+      if(!files.length){
+        try{setStatus('PS1 — RESCAN DOSSIER REQUIS');showToast('PS1 CUE/BIN : rescanne le dossier ROMS avant de lancer.',4800);}catch(_){ }
+        return;
+      }
+      try{setStatus('PS1 — LECTURE CUE + BIN…');}catch(_){ }
+      Promise.resolve(resolvePsxCueBundle(files,file)).then(bundle=>{
+        if(!bundle.refs.length){try{setStatus('PS1 — CUE SANS PISTE');showToast('PS1 : ce CUE ne référence aucun fichier disque.',5000);}catch(_){ }return;}
+        if(bundle.missing.length){try{setStatus('PS1 — FICHIER MANQUANT');showToast(`PS1 : ${bundle.missing.length} fichier(s) référencé(s) introuvable(s).`,5200);}catch(_){ }return;}
+        try{setStatus(`PS1 — ${bundle.files.length} piste(s)${bios?' + BIOS':''} • CHARGEMENT…`);}catch(_){ }
+        return launchPrepared(bundle.externalFiles);
+      }).catch(err=>{
+        console.warn('RetroRoom PSX CUE',err);
+        try{setStatus('PS1 — ERREUR LECTURE CUE');showToast('PS1 : impossible de préparer le CUE/BIN.',5200);}catch(_){ }
+      });
+    };
+  }
+
+  globalThis.__RETROOM_PSX_V626__={canonicalizePsxDiscFiles,resolvePsxCueBundle,processBiosSelection,choosePsxBios};
+  globalThis.__RETROOM_PSX_V626_TEST__={
+    normalizePath,cueFileReferences,canonicalizePsxDiscFiles,resolvePsxCueBundle,
+    isPsxBiosName,isBiosArchiveExt,psxCanonicalName,pickPsxBiosFromExtracted,collectRecognizedFromExtracted,choosePsxBios
+  };
+})();
+</script>
