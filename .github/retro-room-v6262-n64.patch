+  let pointerId=null;
+  const last=new Map([[16,0],[17,0],[18,0],[19,0]]);
+
+  function sendAnalog(index,value){
+    const v=Math.max(0,Math.min(1,Number(value)||0));
+    const prev=last.get(index)||0;
+    if(Math.abs(prev-v)<0.025&&!(v===0&&prev!==0))return;
+    last.set(index,v);
+    try{sendInput(index,v);}catch(_){ }
+  }
+  function releaseAnalog(){
+    sendAnalog(16,0);sendAnalog(17,0);sendAnalog(18,0);sendAnalog(19,0);
+    if(knob)knob.style.transform='translate(-50%,-50%)';
+    pointerId=null;
+  }
+  function updateAnalog(e){
+    if(!gate||!knob)return;
+    const r=gate.getBoundingClientRect();
+    const cx=r.left+r.width/2,cy=r.top+r.height/2;
+    const maxTravel=Math.max(1,r.width*0.29);
+    let x=(e.clientX-cx)/maxTravel;
+    let y=(e.clientY-cy)/maxTravel;
+    let mag=Math.hypot(x,y);
+    if(mag>1){x/=mag;y/=mag;mag=1;}
+    const dead=.12;
+    if(mag<dead){x=0;y=0;mag=0;}
+    else{
+      const scaled=(mag-dead)/(1-dead);
+      const norm=Math.hypot(x,y)||1;
+      x=(x/norm)*scaled;y=(y/norm)*scaled;
+    }
+    knob.style.transform=`translate(-50%,-50%) translate(${(x*maxTravel).toFixed(1)}px,${(y*maxTravel).toFixed(1)}px)`;
+    sendAnalog(16,Math.max(0,x));
+    sendAnalog(17,Math.max(0,-x));
+    sendAnalog(18,Math.max(0,y));
+    sendAnalog(19,Math.max(0,-y));
+  }
+  function onDown(e){
+    if(app.dataset.n64Layout!=='1'||pointerId!==null)return;
+    e.preventDefault();e.stopPropagation();pointerId=e.pointerId;
+    try{stick.setPointerCapture(pointerId);}catch(_){ }
+    updateAnalog(e);
+  }
+  function onMove(e){if(e.pointerId!==pointerId)return;e.preventDefault();e.stopPropagation();updateAnalog(e);}
+  function onUp(e){if(e.pointerId!==pointerId)return;e.preventDefault();e.stopPropagation();try{stick.releasePointerCapture(pointerId);}catch(_){ }releaseAnalog();}
